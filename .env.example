# AlgoVerse API server configuration
# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Server ------------------------------------------------------------------
PORT=8787
# HOST=                    # default: 127.0.0.1 in development, 0.0.0.0 with `npm start` (production)
# ALLOWED_ORIGIN=          # only needed if the frontend is served from a different origin

# --- Judge0 code execution ---------------------------------------------------
# Leave JUDGE0_URL empty and code execution stays disabled; the UI says so.
#
# Option A: self-hosted Judge0 CE (https://github.com/judge0/judge0)
#   JUDGE0_URL=http://localhost:2358
#   JUDGE0_AUTH_TOKEN=          # only if AUTHN_TOKEN is set in judge0.conf
#
# Option B: hosted Judge0 CE on RapidAPI
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_RAPIDAPI_KEY=your-rapidapi-key
#   JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
#
# Option C: OnlineCompiler.io (Judge0-compatible API, free plan; https://onlinecompiler.io/docs/judge0)
#   JUDGE0_URL=https://api.onlinecompiler.io/api/judge0
#   JUDGE0_AUTH_TOKEN=your-onlinecompiler-api-key   # sent only from the server, as X-Auth-Token
#   Leave JUDGE0_RAPIDAPI_KEY and JUDGE0_RAPIDAPI_HOST empty.
#   Verify with: npm run judge0:check
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=

# Judge0 language ids (defaults match Judge0 CE: Java 13 = 62, C++17/GCC 9 = 54, Python 3.8 = 71).
# Check GET {JUDGE0_URL}/languages on your instance if you use different versions,
# or run `npm run judge0:check`, which looks each id up and runs a test program.
# JUDGE0_LANGUAGE_JAVA=62
# JUDGE0_LANGUAGE_CPP=54
# JUDGE0_LANGUAGE_PYTHON=71

# Limits per test case
# JUDGE0_CPU_TIME_LIMIT=2          # seconds
# JUDGE0_WALL_TIME_LIMIT=5         # seconds
# JUDGE0_MEMORY_LIMIT_KB=256000
# JUDGE0_CONCURRENCY=3             # test cases run in parallel per request
# JUDGE0_RETRIES=2                 # retries on HTTP 429 (rate/pending limit) and 503, with backoff
# JUDGE0_BASE64=                   # empty = auto (plain text for OnlineCompiler.io, base64 otherwise); true/false to force

# Abuse protection
# MAX_CODE_BYTES=65536
# RATE_LIMIT_MAX=40                # run/submit requests per client...
# RATE_LIMIT_WINDOW_MS=300000      # ...per 5 minutes

# --- Claude AI features (AI Tutor, Code Analyzer, Question Generator, Roadmap) ---
# Get a key at https://console.anthropic.com/ (Settings → API Keys).
# The key is read ONLY by the API server. It is never sent to the browser,
# never bundled into the frontend, and .env is git-ignored. Do NOT prefix it
# with VITE_ (that would expose it to the browser).
# Leave it empty and the AI pages show "AI is not configured yet".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=           # optional; leave unset to use https://api.anthropic.com
# ANTHROPIC_TIMEOUT_MS=90000
# ANTHROPIC_MAX_RETRIES=2       # the SDK retries 429/5xx/connection errors with backoff
# Structured features (Code Reviewer, Complexity, Questions, Roadmap):
#   auto        = Anthropic structured outputs (output_config.format json_schema); if the model
#                 rejects them, fall back to JSON-in-prompt. Responses are always validated.
#   json_schema = structured outputs only      prompt = JSON-in-prompt only
# ANTHROPIC_STRUCTURED_MODE=auto
# ANTHROPIC_STRUCTURED_TIMEOUT_MS=240000
# ANTHROPIC_THINKING_HEADROOM_TOKENS=8000   # extra max_tokens for models that think by default

# AI abuse protection and input limits
# AI_RATE_LIMIT_MAX=20                 # AI requests per client...
# AI_RATE_LIMIT_WINDOW_MS=300000       # ...per 5 minutes
# AI_MAX_MESSAGE_CHARS=6000            # one tutor message
# AI_MAX_CONVERSATION_CHARS=40000      # tutor history sent per turn (older turns are dropped)
# AI_MAX_MESSAGES=30
# AI_MAX_CODE_CHARS=20000              # code sent for review / complexity analysis

# --- Production & security (Phase 7) --------------------------------------------
# `npm start` runs in production mode (or set NODE_ENV=production). Production mode:
#   - requires a signed-in Supabase user for AI features and code execution
#   - listens on 0.0.0.0, logs one line per API request
# Development (`npm run server`, `npm run dev:full`) keeps everything open on localhost.
#
# Override the sign-in requirement (default: true in production, false in development):
# AI_REQUIRE_AUTH=true
# EXECUTION_REQUIRE_AUTH=true
#
# TRUST_PROXY: set ONLY when a reverse proxy / load balancer / PaaS router sits in front
# of this server (Nginx, Caddy, Render, Railway, Fly.io, Heroku, Cloudflare, …).
# Value = number of proxy hops (usually 1). It makes rate limits use the visitor's real IP
# and enables HSTS for HTTPS traffic. Leave EMPTY when browsers connect directly; if set
# without a proxy, visitors could fake their IP with an X-Forwarded-For header.
# TRUST_PROXY=1
#
# Extra origins the browser may connect to (space-separated), added to the
# Content-Security-Policy. The Supabase URL is added automatically.
# CSP_CONNECT_SRC=
#
# LOG_REQUESTS=true                    # default: true in production, false in development
# SHUTDOWN_TIMEOUT_MS=10000            # on stop/redeploy, wait this long for running requests
# ACCOUNT_RATE_LIMIT_MAX=60            # /api/account requests per user (or IP)…
# ACCOUNT_RATE_LIMIT_WINDOW_MS=60000   # …per minute

# --- Supabase (database + authentication) – optional; without it AlgoVerse runs in local mode ---
# Supabase dashboard → Project Settings → API Keys.
#
# Server-only (read by the Express API; never bundled into the browser):
SUPABASE_URL=
# Publishable key: sb_publishable_… (or the legacy anon key)
SUPABASE_PUBLISHABLE_KEY=
# Secret key: sb_secret_… (or the legacy service_role key). Bypasses RLS: SERVER ONLY.
# Required to save judged submissions to signed-in users' accounts.
SUPABASE_SECRET_KEY=
#
# Browser (these two are designed to be public; RLS protects every row):
VITE_SUPABASE_URL=
# The SAME publishable key as above. NEVER put a secret key in a VITE_ variable
# (the build refuses to run if you do).
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# Sign-in for AI / code execution: see "Production & security" above (on by default with `npm start`).
